{
  "schemaVersion": 1,
  "id": "${MODID}",
  "name": "${NAME}",
  "version": "${VERSION}",
  "environment": "*",
  "icon": "icon.png",
  "authors": ["${AUTHOR}"],
  "license": "MIT",
  "contact": {
    "homepage": "${CURSE_HOMEPAGE}",
    "sources": "${GIT_REPO}",
    "issues": "${GIT_REPO}/issues"
  },
  "description": "${DESCRIPTION}",
  "entrypoints": {
    "main": [
      "com.blamejared.dustydiscoveries.fabric.DustyDiscoveriesFabric"
    ],
    "client": [
      "com.blamejared.dustydiscoveries.fabric.DustyDiscoveriesFabricClient"
    ],
    "jei_mod_plugin": [
      "com.blamejared.dustydiscoveries.compat.jei.DDJEIPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=${FABRIC_LOADER}",
    "java": ">=${JAVA}",
    "minecraft": "${MINECRAFT}"
  },
  "custom": {},
  "mixins": [
    {
      "config": "${MODID}.mixins.json",
      "environment": "*"
    }
  ]
}